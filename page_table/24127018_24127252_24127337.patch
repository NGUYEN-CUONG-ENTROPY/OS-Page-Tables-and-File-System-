-        print("Part %s score: %d/%d" % \
-            (name, TOTAL - PART_TOTAL, POSSIBLE - PART_POSSIBLE))
-        print()
-        PART_TOTAL, PART_POSSIBLE = TOTAL, POSSIBLE
-    show_part.title = ""
