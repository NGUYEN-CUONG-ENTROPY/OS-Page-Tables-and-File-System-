+void *
+superalloc(void)
+{
+  struct run *prev, *head, *tail, *next;
+  char *base;
+
+  acquire(&kmem.lock);
+  prev = 0;
+  for(head = kmem.freelist; head; prev = head, head = head->next){
+    if((((uint64)head) & (SUPERPGSIZE - 1)) != (SUPERPGSIZE - PGSIZE))
+      continue;
+
+    tail = head;
+    for(int i = 1; i < SUPERPGSIZE / PGSIZE; i++){
+      next = tail->next;
+      if(next == 0 || (char*)next != (char*)tail - PGSIZE)
+        break;
+      tail = next;
+    }
+
+    if((char*)tail != (char*)head - (SUPERPGSIZE - PGSIZE))
+      continue;
+
+    next = tail->next;
+    if(prev)
+      prev->next = next;
+    else
+      kmem.freelist = next;
+    release(&kmem.lock);
+
+    base = (char*)tail;
+    memset(base, 5, SUPERPGSIZE);
+    return base;
+  }
+  release(&kmem.lock);
+
+  return 0;
+}
+
+void
+superfree(void *pa)
+{
+  char *p;
+
+  if(((uint64)pa % SUPERPGSIZE) != 0 || (char*)pa < end || (uint64)pa + SUPERPGSIZE > PHYSTOP)
+    panic("superfree");
+
+  for(p = (char*)pa; p < (char*)pa + SUPERPGSIZE; p += PGSIZE)
+    kfree(p);
+}
+#endif
