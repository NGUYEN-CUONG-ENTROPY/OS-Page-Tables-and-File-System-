+#ifdef LAB_PGTBL
+static void
+vmprint_rec(pagetable_t pagetable, int depth)
+{
+  for(int i = 0; i < 512; i++){
+    pte_t pte = pagetable[i];
+    if((pte & PTE_V) == 0)
+      continue;
+    // print indentation: (depth+1) copies of ".." separated by spaces
+    for(int d = 0; d <= depth; d++){
+      if(d > 0) printf(" ");
+      printf("..");
+    }
+    printf("%d: pte %p pa %p\n", i, (void*)pte, (void*)PTE2PA(pte));
+    // recurse into non-leaf PTEs
+    if((pte & (PTE_R|PTE_W|PTE_X)) == 0){
+      pagetable_t child = (pagetable_t)PTE2PA(pte);
+      vmprint_rec(child, depth + 1);
+    }
+  }
+}
+
+void
+vmprint(pagetable_t pagetable)
+{
+  printf("page table %p\n", pagetable);
+  vmprint_rec(pagetable, 0);
+}
+
+static uint64
+canonva(uint64 va)
+{
+  if(va & (1L << 38))
+    va |= ~((1L << 39) - 1);
+  return va;
+}
+
+static void
+kpgtblprint_rec(pagetable_t pagetable, int level, int depth, uint64 base)
+{
+  for(int i = 0; i < 512; i++) {
+    pte_t pte = pagetable[i];
+    uint64 va;
+
+    if((pte & PTE_V) == 0)
+      continue;
+
+    va = base | ((uint64)i << PXSHIFT(level));
+    printf(" ");
+    for(int d = 0; d <= depth; d++) {
+      if(d > 0)
+        printf(" ");
+      printf("..");
+    }
+    printf("%p\n", (void*)canonva(va));
+
+    if(level > 0 && !PTE_LEAF(pte))
+      kpgtblprint_rec((pagetable_t)PTE2PA(pte), level - 1, depth + 1, va);
+  }
+}
+
+void
+kpgtblprint(pagetable_t pagetable)
+{
+  printf("page table %p\n", pagetable);
+  kpgtblprint_rec(pagetable, 2, 0, 0);
+}
+#endif
